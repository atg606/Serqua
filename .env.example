# Public Shopify Customer Account API client ID from:
# Shopify Admin > Sales channels > Headless > Customer Account API settings
VITE_SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=

# Shopify requires an HTTPS callback. Use the production URL below when deploying,
# or replace it with an HTTPS tunnel URL while testing locally.
VITE_SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=https://serqua.in/customer-auth/callback/
