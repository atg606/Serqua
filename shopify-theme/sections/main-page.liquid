<article class="native-page">
  <h1>{{ page.title }}</h1>
  <div class="native-page__content">{{ page.content }}</div>
</article>

{% stylesheet %}
  .native-page { max-width: 920px; min-height: 55vh; margin: 0 auto; padding: clamp(55px, 8vw, 110px) 20px; }
  .native-page h1 { margin: 0 0 42px; font-family: "Barlow Condensed", sans-serif; font-size: clamp(58px, 8vw, 96px); font-weight: 600; line-height: .88; text-transform: uppercase; }
  .native-page__content { font-size: 16px; line-height: 1.75; }
  .native-page__content h2 { margin-top: 45px; font-family: "Barlow Condensed", sans-serif; font-size: 38px; font-weight: 600; text-transform: uppercase; }
  .native-page__content a { border-bottom: 1px solid currentColor; }
{% endstylesheet %}

{% schema %}{"name":"Main page","settings":[]}{% endschema %}
