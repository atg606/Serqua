<section class="mag-cover mag-cover--pair mag-cover--portrait" aria-labelledby="mag-title">
        <div class="mag-cover__art" aria-hidden="true">
          <img src="{{ 'serqua-mag-cover-strength-updated.jpeg' | asset_url }}" width="960" height="1280" alt="" fetchpriority="high" />
        </div>
        <div class="mag-cover__shade" aria-hidden="true"></div>
        <div class="mag-cover__masthead">
          <p class="mag-cover__label">{{ 'magazine.copy_1' | t }}</p>
          <h1 id="mag-title"><span>{{ 'magazine.copy_2' | t }}</span><em>{{ 'magazine.copy_67' | t }}</em></h1>
          <div class="mag-cover__intro">
            <h2>{{ 'magazine.copy_4' | t }}</h2>
            <p>{{ 'magazine.update_20260924_1' | t }}<br />{{ 'magazine.update_20260924_2' | t }}</p>
          </div>
        </div>
        <div class="mag-cover__notes" aria-label="Issue details">
          <p>{{ 'magazine.copy_22' | t }}<br />{{ 'magazine.copy_7' | t }}</p>
          <p>{{ 'magazine.copy_8' | t }}<br />{{ 'magazine.copy_9' | t }}</p>
        </div>
        <a class="mag-cover__enter" href="#issue-one">{{ 'magazine.copy_10' | t }}<span aria-hidden="true">↓</span></a>
      </section>

      <div class="mag-breath" aria-hidden="true"></div>

      <section class="mag-opening" id="issue-one" aria-labelledby="opening-title">
        <p class="mag-running-line"><span></span>{{ 'magazine.copy_11' | t }}<span></span></p>
        <div class="mag-opening__grid">
          <figure class="mag-opening__group mag-opening__group--strength">
            <img src="{{ 'serqua-mag-story-strength.jpeg' | asset_url }}" width="1200" height="1600" alt="Athlete wearing sunglasses and holding a fully visible Prollagen Bourbon Vanilla jar" />
            <figcaption>{{ 'magazine.copy_12' | t }}</figcaption>
          </figure>

          <header class="mag-opening__copy mag-opening__copy--resilience">
            <p class="mag-folio">{{ 'magazine.copy_13' | t }}</p>
            <h2 id="opening-title">{{ 'magazine.update_20260924_3' | t }}</h2>
            <div class="mag-opening__story">
              <p>{{ 'magazine.update_20260924_4' | t }}</p>
              <p>{{ 'magazine.update_20260924_5' | t }}</p>
              <p>{{ 'magazine.update_20260924_6' | t }}</p>
            </div>
          </header>

          <div class="mag-slider" data-mag-slider tabindex="0" role="region" aria-label="Issue 01 portrait story carousel">
            <div class="mag-slider__track" data-slider-track>
              <figure class="mag-slide" data-slide>
                <img class="mag-slide__artwork" src="{{ 'serqua-beauty-build.jpeg' | asset_url }}" width="1024" height="1536" alt="Beauty &amp; the Build — The synergy of protein &amp; vitamin C" />
              </figure>
              <figure class="mag-slide" data-slide>
                <img src="{{ 'catalog-radiance-portrait.jpeg' | asset_url }}" alt="Athlete standing against a clean studio background" width="1024" height="1536" />
                <figcaption>{{ 'magazine.copy_18' | t }}</figcaption>
              </figure>
              <figure class="mag-slide" data-slide>
                <img src="{{ 'catalog-recovery-stretch.jpeg' | asset_url }}" alt="Athlete stretching beside a Prollagen jar" width="1200" height="1600" />
                <figcaption>{{ 'magazine.copy_19' | t }}</figcaption>
              </figure>
            </div>
            <p class="mag-slider__count" aria-live="polite"><span data-slider-current>01</span> / <span data-slider-total>03</span></p>
          </div>
        </div>
      </section>

      <section class="mag-feature" aria-labelledby="feature-title">
        <figure class="mag-feature__image">
          <img src="{{ 'catalog-handstand.jpeg' | asset_url }}" alt="Athlete holding a controlled handstand in a bright studio" loading="lazy" width="1200" height="1600" />
          <figcaption>{{ 'magazine.copy_20' | t }}</figcaption>
        </figure>
        <div class="mag-feature__headline">
          <p class="mag-folio">{{ 'magazine.copy_21' | t }}</p>
          <h2 id="feature-title">{{ 'magazine.copy_22' | t }}<br /><em>{{ 'magazine.copy_23' | t }}</em></h2>
        </div>
        <aside class="mag-feature__aside">
          <h3>{{ 'magazine.copy_24' | t }}<br />{{ 'magazine.copy_25' | t }}</h3>
          <p>{{ 'magazine.copy_26' | t }}</p>
          <a href="#campaign">{{ 'magazine.copy_27' | t }}<span aria-hidden="true">↓</span></a>
        </aside>
      </section>

      <section class="mag-campaign" id="campaign" aria-labelledby="campaign-title">
        <div class="mag-campaign__nutrition">
          <p>{{ 'magazine.copy_28' | t }}</p>
          <dl>
            <div><dt>{{ 'magazine.copy_29' | t }}</dt><dd>{{ 'magazine.copy_30' | t }}</dd></div>
            <div><dt>{{ 'magazine.copy_31' | t }}</dt><dd>{{ 'magazine.copy_32' | t }}</dd></div>
          </dl>
          <p>{{ 'magazine.copy_33' | t }}<br />{{ 'magazine.copy_34' | t }}</p>
          <p class="mag-campaign__closing">{{ 'magazine.copy_70' | t }}<br />{{ 'magazine.copy_71' | t }}<br />{{ 'magazine.copy_72' | t }}<br />{{ 'magazine.copy_73' | t }}</p>
        </div>
        <figure class="mag-campaign__product">
          <img src="{{ 'prollagen-campaign-product-v2.png' | asset_url }}" alt="Prollagen Bourbon Vanilla jar displayed on glossy black volcanic rocks" loading="lazy" width="1112" height="1415" />
        </figure>
        <div class="mag-campaign__copy">
          <h2 id="campaign-title">{{ 'magazine.copy_36' | t }}</h2>
          <p class="mag-campaign__tagline">{{ 'magazine.copy_37' | t }}</p>
          <ul class="mag-campaign__benefits" aria-label="Product benefits">
            <li><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M15 20h18v8H15M7 12h8v24H7zM33 12h8v24h-8zM3 18h4v12H3zM41 18h4v12h-4z"/></svg><strong>{{ 'magazine.copy_38' | t }}</strong><span>{{ 'magazine.copy_39' | t }}</span></li>
            <li><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M18 3c0 11-4 15-13 17 9 2 13 6 13 17 2-11 6-15 15-17-9-2-13-6-15-17ZM36 27c0 5-2 8-7 9 5 1 7 4 7 9 1-5 3-8 8-9-5-1-7-4-8-9ZM36 3v10M31 8h10"/></svg><strong>{{ 'magazine.copy_40' | t }}</strong><span>{{ 'magazine.copy_41' | t }}</span></li>
            <li><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="20"/><path d="M24 8v16h12M34 11v10M29 16h10"/></svg><strong>{{ 'magazine.copy_42' | t }}</strong><span>{{ 'magazine.copy_43' | t }}</span></li>
            <li><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M9 35C1 17 22 8 43 3c-3 22-12 41-31 31M5 44 34 13"/></svg><strong>{{ 'magazine.copy_44' | t }}</strong><span>{{ 'magazine.copy_45' | t }}</span></li>
          </ul>
          <a class="mag-campaign__cta" href="{{ routes.all_products_collection_url }}">{{ 'magazine.copy_46' | t }}<span aria-hidden="true">→</span></a>
          <p class="mag-campaign__signature">{{ 'magazine.copy_74' | t }}</p>
        </div>
      </section>

      <section class="mag-editorial" aria-labelledby="collagen-title" aria-roledescription="carousel" data-editorial-slider>
        <header class="mag-editorial__header">
          <div><p class="mag-folio">{{ 'magazine.update_20260924_7' | t }}</p><h2 id="collagen-title">{{ 'magazine.update_20260924_8' | t }}</h2></div>
          <p>{{ 'magazine.update_20260924_9' | t }}</p>
        </header>
        <figure class="mag-editorial__lifestyle">
          <img src="{{ 'catalog-editorial-ritual.jpeg' | asset_url }}" alt="Athlete packing a Prollagen jar into his gym bag" width="960" height="1280" loading="lazy" />
        </figure>
        <div class="mag-editorial__viewport" tabindex="0" aria-label="Collagen story. Use left and right arrow keys to turn pages.">
          <figure data-editorial-slide><img src="{{ 'collagen-story-01.jpg' | asset_url }}" alt="Decoding collagen: the science behind the shine — cover" width="1024" height="1536" loading="lazy" /></figure>
          <figure data-editorial-slide hidden><img src="{{ 'collagen-story-02.jpg' | asset_url }}" alt="Decoding collagen: collagen synthesis and vitamin C" width="1024" height="1536" loading="lazy" /></figure>
          <figure data-editorial-slide hidden><img src="{{ 'collagen-story-03.jpg' | asset_url }}" alt="Decoding collagen: illustrated skin changes" width="1024" height="1536" loading="lazy" /></figure>
          <figure data-editorial-slide hidden><img src="{{ 'collagen-story-04.jpg' | asset_url }}" alt="Skin-care isn’t just on the outside" width="1024" height="1536" loading="lazy" /></figure>
          <figure data-editorial-slide hidden><img src="{{ 'collagen-story-05-updated.jpeg' | asset_url }}" alt="Stay balanced from the inside-out with Prollagen" width="1024" height="1536" loading="lazy" /></figure>
          <button class="mag-editorial__arrow mag-editorial__arrow--prev" type="button" data-editorial-prev aria-label="Previous page">←</button>
          <button class="mag-editorial__arrow mag-editorial__arrow--next" type="button" data-editorial-next aria-label="Next page">→</button>
        </div>
        <div class="mag-editorial__controls">
          <span data-editorial-count role="status" aria-live="polite" aria-atomic="true">01 / 05</span>
        </div>
      </section>

      <section class="mag-after" aria-labelledby="after-title">
        <article class="mag-after__lead mag-after__lead--movement">
          <div class="mag-after__copy">
            <p class="mag-folio">{{ 'magazine.copy_47' | t }}</p>
            <h2 id="after-title">{{ 'magazine.update_20260924_10' | t }}</h2>
            <div class="mag-after__story">
              <p>{{ 'magazine.update_20260924_11' | t }}<br />{{ 'magazine.update_20260924_12' | t }}</p>
              <p>{{ 'magazine.update_20260924_13' | t }}<br />{{ 'magazine.update_20260924_14' | t }}</p>
              <p>{{ 'magazine.update_20260924_15' | t }}</p>
              <p>{{ 'magazine.update_20260924_16' | t }}</p>
            </div>
          </div>
          <figure class="mag-after__movement">
            <img src="{{ 'catalog-anatomy-movement.jpeg' | asset_url }}" alt="Two poses of an athlete in black holding dumbbells" width="900" height="1200" loading="lazy" />
            <figcaption>{{ 'magazine.copy_51' | t }}</figcaption>
          </figure>
        </article>

        <div class="mag-after__gallery">
          <figure class="mag-after__portrait">
            <img src="{{ 'catalog-gallery-training-pair.jpeg' | asset_url }}" alt="Two athletes with a shaker and Prollagen jar in a warm studio" loading="lazy" width="960" height="1280" />
            <figcaption>{{ 'magazine.copy_52' | t }}</figcaption>
          </figure>
          <figure class="mag-after__motion">
            <img src="{{ 'catalog-gallery-recovery.jpeg' | asset_url }}" alt="Athlete stretching with a Prollagen jar in front of him" loading="lazy" width="960" height="1280" />
            <figcaption>{{ 'magazine.copy_53' | t }}</figcaption>
          </figure>
          <figure class="mag-after__ritual">
            <img src="{{ 'collagen-story-lifestyle.jpeg' | asset_url }}" alt="Athlete tying his shoe beside a ladder, with a Prollagen jar, shaker and gym bag" loading="lazy" width="1200" height="1600" />
            <figcaption>{{ 'magazine.copy_54' | t }}</figcaption>
          </figure>
        </div>
      </section>

      <section class="mag-conclusion" aria-labelledby="conclusion-title">
        <p class="mag-folio">{{ 'magazine.copy_55' | t }}</p>
        <div class="mag-conclusion__grid">
          <h2 id="conclusion-title">{{ 'magazine.copy_56' | t }}<br />{{ 'magazine.copy_57' | t }}<br />{{ 'magazine.copy_58' | t }}</h2>
          <div>
            <p>{{ 'magazine.copy_59' | t }}</p>
            <p class="mag-conclusion__signoff"><em>{{ 'magazine.copy_60' | t }}<br />{{ 'magazine.copy_61' | t }}</em></p>
          </div>
          <p class="mag-conclusion__note">{{ 'magazine.copy_62' | t }}<br />{{ 'magazine.copy_63' | t }}</p>
        </div>
      </section>

