<section class="hero" id="top" aria-labelledby="hero-title">
        <img class="hero-image" src="{{ 'prollagen-bourbon-hero-v2.jpeg' | asset_url }}" width="1536" height="1024" fetchpriority="high" alt="Prollagen Bourbon Vanilla jar surrounded by a vanilla splash, vanilla pods and ice on black" />
        <div class="hero-shade"></div>
        <div class="hero-content">
          <p class="hero-product">Introducing Prollagen™</p>
          <h1 id="hero-title">Better lifts,<br />better skin</h1>
          <p class="hero-support">Protein and collagen, thoughtfully formulated for the body you train and the skin you live in.</p>
          <div class="hero-actions">
            <a class="button button-light" href="{{ routes.all_products_collection_url }}">Discover Prollagen</a>
            <a class="text-link" href="#world">Enter the <span class="brand-script">Serqua</span> world <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="hero-formula" aria-label="Key product information">
          <span><strong>24g</strong> protein</span>
          <span><strong>Type I &amp; III</strong> collagen</span>
          <span><strong>120mg</strong> Vitamin C</span>
          <span><strong>Bourbon vanilla</strong> flavour*</span>
        </div>
      </section>

<section class="world" id="world" aria-labelledby="world-title">
        <div class="world-statement">
          <p>Fitness + beauty, from the inside out.</p>
          <h2 id="world-title">Balanced,<br />inside-out</h2>
        </div>
        <div class="world-copy">
          <div class="world-monogram" aria-hidden="true">S/Q</div>
          <p class="world-lead"><span class="brand-script">Serqua</span> creates holistic performance supplements for fast-paced lives.</p>
          <p>We bridge fitness and beauty without choosing a side—supporting performance, recovery, skin, joints and everyday wellbeing.</p>
          <a class="text-link dark" href="#why">Why <span class="brand-script">Serqua</span> <span aria-hidden="true">→</span></a>
        </div>
      </section>

<section class="shop" id="shop" aria-labelledby="shop-title-{{ section.id }}">
  <header class="section-heading">
    <div><p class="section-note">{{ section.settings.shop_eyebrow }}</p><h2 id="shop-title-{{ section.id }}">{{ section.settings.shop_title }}</h2></div>
    <p class="shop-manifesto"><strong>{{ section.settings.shop_manifesto }}</strong><span>{{ section.settings.shop_manifesto_copy }}</span></p>
  </header>
  <div class="product-grid">
    {% assign home_collection = section.settings.featured_collection | default: collections.all %}
    {% for product in home_collection.products limit: 2 %}
      {% render 'product-card', product: product, context: 'home' %}
    {% else %}
      <article class="product-card">
        <div class="product-image product-large"><img src="{{ 'prollagen-bourbon-1kg.jpeg' | asset_url }}" width="1254" height="1254" alt="Prollagen one kilogram Bourbon Vanilla jar"></div>
        <div class="product-details"><div><p class="product-size">PROL-1000</p><h3>Prollagen™ 1kg</h3></div><div class="product-buy"><p><del>₹6,499</del> <strong>₹5,499</strong></p><button class="add-button" type="button" disabled>{{ 'products.coming_soon' | t }}</button></div></div>
      </article>
      <article class="product-card">
        <div class="product-image product-mini"><img src="{{ 'prollagen-bourbon-500g.jpeg' | asset_url }}" width="1254" height="1254" alt="Prollagen 500 gram Bourbon Vanilla jar"></div>
        <div class="product-details"><div><p class="product-size">PROL-500</p><h3>Prollagen™ 500g</h3></div><div class="product-buy"><p><del>₹3,499</del> <strong>₹2,999</strong></p><button class="add-button" type="button" disabled>{{ 'products.coming_soon' | t }}</button></div></div>
      </article>
    {% endfor %}
  </div>
</section>

<section class="benefits" id="why" aria-labelledby="benefits-title">
        <div class="benefits-intro">
          <p>One daily formula</p>
          <h2 id="benefits-title">Made for more than the mirror.</h2>
          <p>Prollagen™ combines whey protein isolate and collagen peptides with selected nutrients for performance, recovery and beauty.</p>
        </div>
        <div class="benefit-list">
          <article><span>01</span><h3>Performance</h3><p>24g high-quality protein per serving supports muscle development and recovery.</p></article>
          <article><span>02</span><h3>Skin + collagen</h3><p>Type I &amp; III collagen with Vitamin C supports skin health and collagen formation.</p></article>
          <article><span>03</span><h3>Joints + connection</h3><p>Collagen and MSM complement a routine focused on joints and connective tissue.</p></article>
          <article><span>04</span><h3>Everyday wellbeing</h3><p>Zero added sugar, zero carbohydrates and DigeZyme® digestive enzymes.</p></article>
        </div>
      </section>

<section class="ingredients" id="ingredients" aria-labelledby="ingredients-title">
        <div class="ingredient-stage"><img src="{{ 'prollagen-ingredient-science.jpeg' | asset_url }}" width="1254" height="1254" alt="Prollagen Bourbon Vanilla ingredient graphic featuring whey protein isolate, marine collagen, Vitamin C and MSM" loading="lazy" /></div>
        <div class="ingredient-copy">
          <p class="section-note">Inside every scoop</p>
          <h2 id="ingredients-title">Science, Skin and Strength</h2>
          <ul>
            <li><span>01</span><strong>Whey protein isolate</strong><small>Muscle development + recovery</small></li>
            <li><span>02</span><strong>Type I &amp; III collagen</strong><small>Skin, joints + connective tissue</small></li>
            <li><span>03</span><strong>Vitamin C</strong><small>120mg per 30g serving</small></li>
            <li><span>04</span><strong>MSM</strong><small>Joints and recovery support</small></li>
            <li><span>05</span><strong>DigeZyme®</strong><small>Digestive enzyme blend</small></li>
          </ul>
          <p class="formula-note">*Bourbon vanilla is the planned launch flavour; exact naming and final formulation remain subject to approval.</p>
        </div>
      </section>

<section class="social" id="social" aria-labelledby="social-title">
        <header>
          <h2 id="social-title">Inside the <span class="brand-script">Serqua</span> world.</h2>
          <a href="https://www.instagram.com/serqua.in/" target="_blank" rel="noreferrer">Follow @serqua.in <span aria-hidden="true">↗</span></a>
        </header>
        <div class="social-grid">
          <a class="social-image social-product" href="https://www.instagram.com/serqua.in/" target="_blank" rel="noreferrer" aria-label="View the Serqua daily ritual campaign on Instagram"></a>
          <a class="social-image social-detail" href="https://www.instagram.com/serqua.in/" target="_blank" rel="noreferrer" aria-label="View the Serqua strength in motion campaign on Instagram"></a>
          <a class="social-image social-people" href="https://www.instagram.com/serqua.in/" target="_blank" rel="noreferrer" aria-label="View the Serqua radiance campaign on Instagram"></a>
        </div>
      </section>

<section class="service-strip" aria-label="Customer service information">
  <div><strong>Across India</strong><span>Delivery to serviceable locations</span></div><div><strong>3–7 business days</strong><span>Typical delivery timeline</span></div><div><strong>COD available</strong><span>On eligible orders and locations</span></div><div><strong>Here to help</strong><span>WhatsApp support, 9am–8pm</span></div>
</section>

