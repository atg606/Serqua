.wordmark,
.brand-script {
  display: inline-block;
  overflow: hidden;
  color: transparent !important;
  background: url("{{ 'serqua-wordmark-silver.png' | asset_url }}") center / contain no-repeat;
  text-indent: -999em;
  text-shadow: none;
  white-space: nowrap;
}

.wordmark {
  width: 3em;
  height: 1.25em;
}

body > .site-header { position: sticky; top: 0; z-index: var(--z-header, 20); }
html { scroll-padding-top: calc(var(--header, 88px) + 16px); }
.site-header > a.wordmark {
  display: inline-block;
  align-self: center;
  padding: 0;
  width: clamp(112px, 12vw, 156px);
  max-width: 100%;
  height: auto;
  aspect-ratio: 12 / 5;
  transform: none;
}

.brand-script {
  font-size: max(1.2em, 17px);
  width: 2.4em;
  height: 1em;
  vertical-align: -0.22em;
}

#shop-title .brand-script {
  filter: brightness(0);
}
